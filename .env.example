# Hiring Compass local environment
# Copy this file to .env before starting the stack: cp .env.example .env
# Values in this file are development defaults only. Never use them in production.

# Core data services
POSTGRES_DB=hiring_compass
POSTGRES_USER=hiring_compass
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=hiring_compass
RABBITMQ_DEFAULT_PASS=change_me_locally
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Private resume storage (MinIO)
MINIO_ROOT_USER=hiring_compass
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hiring_compass
MINIO_SECRET_KEY=change_me_locally
MINIO_SECURE=false
MINIO_RESUME_BUCKET=hiring-compass-resumes
RESUME_MAX_FILE_SIZE_BYTES=10485760
RESUME_DOWNLOAD_URL_EXPIRE_SECONDS=300

# Local email preview (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API runtime
APP_ENV=development

# SQLAlchemy connection used by the API and migrations
DATABASE_URL=postgresql+asyncpg://hiring_compass:change_me_locally@localhost:5432/hiring_compass

# Authentication and browser cookie settings
# Replace JWT_SECRET_KEY with a long random value for any shared environment.
JWT_SECRET=replace_with_a_long_random_value_for_local_development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# CORS origin for the browser application
SEED_ORGANIZATION_NAME=Hiring Compass
SEED_ORGANIZATION_SLUG=hiring-compass
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@hiring-compass.test
SEED_ADMIN_PASSWORD=change_this_before_running_seed
VITE_API_BASE_URL=http://localhost:8000
